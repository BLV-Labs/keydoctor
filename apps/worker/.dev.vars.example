# Copy to .dev.vars for `pnpm --filter worker dev`. Never commit .dev.vars.
RUN_CHECK_TOKEN=change-me-run-check
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-webhook
# Keeper (ADR 0005): a test key of a testnet account only. Leave empty to keep the job off.
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=
KEEPER_ALERT_CHAT_ID=
# Yield advice (YD2, ADR 0004): a NEAR AI Cloud key. Leave empty to keep the rule order and make no model call.
NEAR_AI_API_KEY=
