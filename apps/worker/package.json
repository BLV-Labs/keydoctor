{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "description": "Key Doctor Cloudflare Worker: MCP server, Telegram bot, proposal watch and daily key diff, with D1.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply key-doctor --local",
    "db:migrate:remote": "wrangler d1 migrations apply key-doctor --remote",
    "test": "node --test --no-warnings=ExperimentalWarning \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "key-doctor": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "22.19.1",
    "wrangler": "4.149.0"
  }
}
