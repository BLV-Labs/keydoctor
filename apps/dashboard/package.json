{
  "name": "dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Key Doctor dashboard: static Cloudflare Pages site. Scans run in the browser through the key-doctor library.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@near-js/crypto": "2.5.1",
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "key-doctor": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "util": "0.12.5"
  }
}
