{
  "name": "keydoctor",
  "private": true,
  "description": "Key Doctor On Call: NEAR access-key health checks and DAO proposal alerts",
  "license": "MIT",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=10"
  },
  "scripts": {
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "stats": "pnpm --filter key-doctor stats",
    "bench": "pnpm --filter key-doctor bench",
    "find-dao": "pnpm --filter key-doctor find-dao"
  },
  "packageManager": "pnpm@10.34.7"
}
